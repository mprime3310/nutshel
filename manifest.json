{
  "manifest_version": 3,
  "name": "NUTSHELL Assistant",
  "short_name": "NUTSHELL",
  "version": "3.5.0",
  "description": "Read a page, answer questions, highlight multiple-choice answers, and review autofill before applying it. Uses your own AI API key (Groq, Gemini, and more).",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus",
    "tabs",
    "windows",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "popup.html",
        "popup.css",
        "popup.js",
        "icon.png",
        "lib/pdf.min.js",
        "lib/pdf.worker.min.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "action": {
    "default_title": "Open NUTSHELL Assistant",
    "default_icon": {
      "128": "icon.png"
    }
  },
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  }
}
